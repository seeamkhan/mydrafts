#!/bin/sh
# project-cockpit pre-commit: keep the context map fresh and refuse a commit
# that breaks the board, the system map or a doc's status.
# Enable once per clone:  git config core.hooksPath .githooks
# Skip once:              git commit --no-verify
root="$(git rev-parse --show-toplevel)"
kit="$root/.cockpit/kit/cockpit.py"
[ -f "$kit" ] || kit="${COCKPIT:-}"
if [ -z "$kit" ] || [ ! -f "$kit" ]; then
  echo "cockpit: kit not found (vendor it with 'cockpit vendor' or set COCKPIT=/path/to/cockpit.py); skipping checks"
  exit 0
fi
python3 "$kit" --root "$root" index >/dev/null && git add "$root/.cockpit/index.md" 2>/dev/null
python3 "$kit" --root "$root" check || {
  echo "cockpit: fix the errors above, or commit with --no-verify"
  exit 1
}
exit 0
